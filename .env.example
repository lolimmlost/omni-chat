# Omni-Chat Configuration

# Admin authentication token (required - use a strong random string!)
ADMIN_TOKEN=your-secret-token-here

# Server port (default: 3100)
PORT=3100

# Ollama API URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Allowed CORS origins (comma-separated, or * for all in dev)
ALLOWED_ORIGINS=https://yourdomain.com,https://chat.yourdomain.com

# Omni-Chat Configuration

# Admin authentication token (required - use a strong random string!)
ADMIN_TOKEN=your-secret-token-here

# Server port (default: 3100)
PORT=3100

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5438/omni_chat
DB_HOST=localhost
DB_PORT=5438
DB_USER=user
DB_PASSWORD=password
DB_NAME=omni_chat
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Feature Flags
USE_DATABASE=true
MULTI_PROVIDER=true
CONTENT_FILTERING=false
CONVERSATION_MEMORY=true

# Ollama Configuration (Local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Configuration (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250514
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-5-sonnet
OPENROUTER_SITE_URL=https://yoursite.com
OPENROUTER_SITE_NAME=OmniChat

# Resend Email Notifications (only sends when visitor requests human help)
RESEND_API_KEY=
NOTIFY_EMAIL=juan@appahouse.com
FROM_EMAIL=Omni-Chat <notifications@appahouse.com>

# Webhooks (Slack/Discord notifications)
WEBHOOK_URL=
WEBHOOK_EVENTS=waiting_human,new_session
DASHBOARD_URL=https://chat.yourdomain.com/admin

# Allowed CORS origins (comma-separated, or * for all in dev)
ALLOWED_ORIGINS=https://yourdomain.com,https://chat.yourdomain.com

# Logging
LOG_LEVEL=info
NODE_ENV=development
